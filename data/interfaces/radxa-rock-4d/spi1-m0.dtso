// SPI1 (M0) with spidev on CS0 and CS1. Written by tools/gen-interfaces.py.
/dts-v1/;
/plugin/;

/ {
	compatible = "radxa,rock-4d", "rockchip,rk3576";
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1m0_csn0 &spi1m0_csn1 &spi1m0_pins>;
	status = "okay";

	spidev@0 {
		compatible = "armbian,spi-dev", "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};

	spidev@1 {
		compatible = "armbian,spi-dev", "rockchip,spidev";
		reg = <1>;
		spi-max-frequency = <10000000>;
	};
};
